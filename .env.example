# ---------------------------------------------------------------------------
# HRMic.ai environment variables
# Copy to .env and fill in real values. .env is gitignored.
# ---------------------------------------------------------------------------

# --- Database: Neon (PostgreSQL) -------------------------------------------
# Pooled connection for the application (has -pooler in the hostname).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct connection for Prisma CLI (migrations, db push, studio). No -pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Cache / Queue: Upstash Redis ------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"
# Cache failures fall back to PostgreSQL instead of delaying a user request.
REDIS_REQUEST_TIMEOUT_MS="750"
# Short-lived cross-request authorization projection. Values are clamped to
# 5-60 seconds; company mutations invalidate the current generation immediately.
AUTHORIZATION_CACHE_TTL_SECONDS="30"
# What to do when Upstash is not configured (or is disabled by a bad value).
# "memory" (default) keeps serving the projection from the instance itself, so
# portal navigations run without an authorization round trip; a revocation made
# on another instance takes effect within AUTHORIZATION_CACHE_TTL_SECONDS.
# "database" reads the database on every request instead (strictly immediate
# revocation across instances, one extra round trip per request).
AUTHORIZATION_CACHE_WITHOUT_REDIS="memory"

# --- Performance monitoring -------------------------------------------------
# Set both to true in the deployed environment to emit anonymous Web Vitals
# and login-to-dashboard timings. Leave false locally unless profiling.
PERFORMANCE_LOGGING="false"
NEXT_PUBLIC_PERFORMANCE_LOGGING="false"
# Required by the scheduled cache warmer in vercel.json.
CRON_SECRET="replace-with-a-long-random-secret"

# --- Object Storage: Cloudflare R2 (S3-compatible) --------------------------
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="hrmic-assets"
R2_PUBLIC_BASE_URL="https://pub-xxxx.r2.dev" # optional, for public reads

# --- Authentication: Auth.js (NextAuth v5) ---------------------------------
# Generate with: npx auth secret
AUTH_SECRET="your-auth-secret"
# Base URL of the app in production (e.g. https://hrmic.ai). Omit in local dev.
AUTH_URL="http://localhost:3000"
# Trust the host header — set true for production deployments behind a proxy.
AUTH_TRUST_HOST="true"

# --- Background Jobs: Inngest ----------------------------------------------
# Leave INNGEST_DEV=1 for local development (connects to the Inngest Dev Server).
INNGEST_DEV="1"
# For Inngest Cloud (production):
INNGEST_EVENT_KEY="your-event-key"
INNGEST_SIGNING_KEY="your-signing-key"

# --- Other ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
